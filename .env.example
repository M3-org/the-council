# Bunny CDN (for video hosting)
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_STORAGE_PASSWORD=your-api-key
BUNNY_CDN_URL=https://your-zone.b-cdn.net
BUNNY_STORAGE_HOST=https://la.storage.bunnycdn.com

# OpenRouter (for Gemini transcription)
OPENROUTER_API_KEY=sk-or-v1-your-key

# YouTube API (for video uploads)
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-refresh-token
YOUTUBE_PLAYLIST_ID=PLxxxxxxxx

# WordPress/Shmotime (for episode fetching)
WORDPRESS_PASSCODE=optional-passcode
